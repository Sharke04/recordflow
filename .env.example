# Local development credentials for docker-compose.
# Copy to .env (git-ignored) and change the values.

# PostgreSQL superuser (used only by the container and the init script)
POSTGRES_DB=mydb
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme

# PostgreSQL role used by Recordflow (created by docker/postgres/init)
RECORDFLOW_PG_PASSWORD=changeme

# ClickHouse administrator (used only by the container and the init script)
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=changeme

# ClickHouse users created by docker/clickhouse/init
RECORDFLOW_CH_PASSWORD=changeme
ANALYST_CH_PASSWORD=changeme
